{
  "timezone": "Asia/Shanghai",
  "askFirst": [
    "Удаление данных",
    "Остановка сервиса",
    "расходы",
    "Отправка сообщений во внешний мир",
    "менять направление продукта",
    "Создать или обновить ключ",
    "Изменение полномочий"
  ],
  "sources": {
    "feedback": {
      "name": "Обратная связь пользователей"
    }
  },
  "agents": {
    "feedback-agent": {
      "name": "Поддержание обратной связи Agent",
      "worker": "my-computer",
      "use": "codex",
      "access": "edit"
    }
  },
  "rules": [
    {
      "name": "Обработка отзывов пользователей",
      "when": {
        "source": "feedback",
        "types": ["feedback.new", "feedback.followup"]
      },
      "to": "feedback-agent",
      "cwd": "~/code/my-project",
      "skill": "handle-feedback",
      "parallel": 3,
      "tell": "needed"
    }
  ],
  "channels": {
    "feishu": {
      "name": "Feishu",
      "answerers": ["ou_REPLACE_ME"]
    }
  }
}
