{
  "timezone": "Asia/Shanghai",
  "askFirst": [
    "Удаление данных",
    "Остановка сервиса",
    "расходы",
    "Отправка сообщений во внешний мир",
    "менять направление продукта",
    "Создать или обновить ключ",
    "Изменение полномочий"
  ],
  "sources": {
    "feishu-brief": {
      "name": "Данные для сводки Feishu"
    }
  },
  "agents": {
    "brief-collector": {
      "name": "Чтение данных Feishu",
      "worker": "my-computer",
      "use": "command",
      "command": ["node", "{cwd}/collect.ts", "{cwd}/sources.json"]
    },
    "brief-agent": {
      "name": "Сводный еженедельный отчет Agent",
      "worker": "my-computer",
      "use": "codex",
      "access": "edit"
    }
  },
  "rules": [
    {
      "name": "Прочитать данные еженедельного отчета Feishu",
      "when": {
        "cron": "0 18 * * 0"
      },
      "to": "brief-collector",
      "cwd": "~/.agent-autoloop/work/feishu-brief",
      "group": "feishu-brief",
      "tell": "needed",
      "emits": {
        "source": "feishu-brief",
        "types": ["brief.ready"]
      }
    },
    {
      "name": "Подготовка еженедельного отчета Feishu и бизнес-сводки",
      "when": {
        "source": "feishu-brief",
        "types": ["brief.ready"]
      },
      "to": "brief-agent",
      "cwd": "~/.agent-autoloop/work/feishu-brief",
      "group": "feishu-brief",
      "skill": "feishu-brief",
      "tell": "needed"
    }
  ],
  "channels": {
    "feishu": {
      "name": "Feishu",
      "answerers": ["ou_REPLACE_ME"]
    }
  }
}
