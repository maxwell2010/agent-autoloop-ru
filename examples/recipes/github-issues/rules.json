{
  "sources": { "github": { "name": "GitHub" } },
  "agents": {
    "watcher": {
      "name": "Проверить новые issue",
      "worker": "mac-mini",
      "use": "command",
      "command": ["{cwd}/examples/watch-github-issues.sh", "owner/repo", "created:>=2026-11-04"]
    },
    "agent": { "name": "Agent", "worker": "mac-mini", "use": "codex", "access": "edit" }
  },
  "rules": [
    {
      "name": "Проверить новые issue",
      "when": { "cron": "*/5 * * * *" },
      "to": "watcher",
      "cwd": "~/.agent-autoloop/app",
      "tell": "never",
      "emits": { "source": "github", "types": ["issues.opened"] }
    },
    {
      "name": "Обработка issue",
      "when": { "source": "github", "types": ["issues.opened"] },
      "to": "agent",
      "cwd": "~/code/app",
      "skill": "handle-issue",
      "parallel": 1
    }
  ]
}
