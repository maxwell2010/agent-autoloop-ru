{
  "askFirst": [
    "Удаление данных",
    "Остановка сервиса",
    "расходы",
    "Отправка сообщений во внешний мир",
    "менять направление продукта",
    "Создать или обновить ключ",
    "Изменение полномочий",
    "На движущейся линии"
  ],
  "sources": {
    "shop": { "name": "shop" },
    "shop-fix": { "name": "shop Ремонт" }
  },
  "agents": {
    "agent": { "name": "Agent", "worker": "mac-mini", "use": "codex", "access": "read" },
    "restart": { "name": "Скрипт перезапуска", "worker": "mac-mini", "use": "command", "command": ["{cwd}/restart.sh"] }
  },
  "rules": [
    {
      "name": "Расследование ошибок production",
      "when": { "source": "shop", "types": ["alert.*"] },
      "to": "agent",
      "cwd": "~/code/shop",
      "skill": "ops-alerts",
      "parallel": 3,
      "emits": { "source": "shop-fix", "types": ["restart"] }
    },
    {
      "name": "Перезапуск",
      "when": { "source": "shop-fix", "types": ["restart"] },
      "to": "restart",
      "cwd": "~/code/shop",
      "tell": "always"
    }
  ]
}
