{
  "timezone": "Asia/Shanghai",
  "askFirst": [
    "Удаление данных",
    "Остановка сервиса",
    "расходы",
    "Отправка сообщений во внешний мир",
    "менять направление продукта",
    "Создать или обновить ключ",
    "Изменение полномочий"
  ],
  "sources": {
    "website-watch": {
      "name": "Мониторинг сайта"
    }
  },
  "agents": {
    "website-check": {
      "name": "Скрипт проверки сайта",
      "worker": "my-computer",
      "use": "command",
      "command": ["node", "{cwd}/check.ts", "{cwd}/site.json"]
    },
    "website-agent": {
      "name": "Обслуживание сайта Agent",
      "worker": "my-computer",
      "use": "codex",
      "access": "read"
    }
  },
  "rules": [
    {
      "name": "Проверить сайт",
      "when": {
        "cron": "*/5 * * * *"
      },
      "to": "website-check",
      "cwd": "~/.agent-autoloop/work/website-watch",
      "group": "website-probe",
      "tell": "needed",
      "emits": {
        "source": "website-watch",
        "types": ["site.down", "site.recovered"]
      }
    },
    {
      "name": "Проверка отклонений на веб-сайте",
      "when": {
        "source": "website-watch",
        "types": ["site.down", "site.recovered"]
      },
      "to": "website-agent",
      "cwd": "~/code/my-project",
      "skill": "website-watch",
      "tell": "needed"
    }
  ],
  "channels": {
    "feishu": {
      "name": "Feishu",
      "answerers": ["ou_REPLACE_ME"]
    }
  }
}
