{
  "timezone": "Asia/Shanghai",
  "sources": {
    "app": { "name": "Применение" },
    "ops": { "name": "运维" },
    "hooks": { "name": "Внешний", "adapter": "echo" }
  },
  "agents": {
    "a1": { "name": "А", "worker": "w1", "use": "claude", "model": "m1", "effort": "high" },
    "a2": { "name": "Б", "worker": "w2", "use": "codex", "access": "full" },
    "a3": { "name": "В", "worker": "w1", "use": "command", "command": ["echo", "{prompt}"] }
  },
  "channels": { "chat": { "name": "聊天", "answerers": ["me"] }, "plain": { "name": "文字", "links": true } },
  "rules": [
    {
      "name": "Мнение",
      "when": { "source": "app", "types": ["feedback.*"] },
      "to": "a1",
      "cwd": "~/x",
      "skill": "s",
      "prompt": "Следуйте руководству.",
      "group": "notes",
      "parallel": 3
    },
    {
      "name": "Тревога",
      "when": { "source": "ops", "types": ["alert.raised"] },
      "to": "a2",
      "cwd": "~/y",
      "prompt": "Обработка сигналов тревоги.",
      "group": "ops",
      "tell": "always"
    },
    {
      "name": "Тревога также записывается.",
      "when": { "source": "ops", "types": ["alert.raised"] },
      "to": "a1",
      "cwd": "~/x",
      "prompt": "记下来。",
      "tell": "never"
    },
    {
      "name": "Утренний обзор",
      "when": { "cron": "0 9 * * *" },
      "to": "a1",
      "cwd": "~/x",
      "prompt": "Напишите утреннюю газету."
    },
    {
      "name": "Осмотр",
      "when": { "cron": "*/5 * * * *" },
      "to": "a3",
      "cwd": "~/y",
      "emits": { "source": "app", "types": ["feedback.new"] }
    }
  ],
  "elsewhere": [
    {
      "name": "Еженедельная очистка",
      "source": "app",
      "to": "a1",
      "cron": "0 6 * * 0",
      "where": "Запланированные задачи в приложениях"
    }
  ]
}
